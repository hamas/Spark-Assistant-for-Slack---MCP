# Spark Assistant for Slack - MCP Server Configuration
# ====================================================

# Slack Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Slack Workspace Team ID (starts with T)
SLACK_TEAM_ID=T00000000

# Optional: Comma-separated list of predefined channel IDs to restrict channel listings (e.g., C0123456,C0789012)
# SLACK_CHANNEL_IDS=C00000000,C11111111

# Optional: Bearer authentication token for HTTP transport mode
# AUTH_TOKEN=your-custom-secret-token
